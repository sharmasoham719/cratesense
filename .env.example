# CrateSense — environment variables
# Copy to .env and fill in real values. .env is gitignored.

# LLM provider (see knowledge-base/TECH_STACK.md §3, §5)
# MOCK_LLM=true (default) uses pre-baked dummy responses, no API calls, no cost.
# Set to false to hit a real provider (requires the matching API key below).
MOCK_LLM=true
# Simulated per-batch-call latency (seconds) for MockLLMProvider, e.g. 2.
# Default 0 (instant) -- set > 0 to exercise batch/concurrency/SSE
# progress realistically without waiting on a real provider.
MOCK_LLM_LATENCY_SECONDS=0
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Batch + concurrency execution model (see knowledge-base/BACKEND_COGNITIVE_FLOW.md)
BATCH_SIZE=5
CONCURRENCY_WINDOW=3
MAX_NODE_RETRIES=2

# Auth bypass for local/dev docker-compose runs (see knowledge-base/AUTH_AND_SECURITY.md)
DEV_OVERRIDE=true

# Google OAuth (NextAuth.js) -- only needed when DEV_OVERRIDE=false.
# Create a Web application OAuth client at console.cloud.google.com
# (APIs & Services > Credentials), with authorized redirect URIs
# {origin}/api/auth/callback/google for each origin you'll run on.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random signing key for NextAuth session JWTs -- generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
